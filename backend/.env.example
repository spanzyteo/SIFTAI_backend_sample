# Copy this file to .env and fill in real values. Never commit .env.

# Ahnlich AI proxy (vector search)
AHNLICH_HOST=ahnlich
AHNLICH_PORT=1370
USE_AHNLICH=true
AHNLICH_STORE_NAME=legal_docs

# Document registry (GET /documents, DELETE /documents/{id}).
# Any standard Postgres connection string works, e.g. a Neon pooled URL:
# postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:npg_ZC9iNoj6Vqhz@ep-shiny-pine-ay9nakg8-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Search-result cache (optional). Leave blank to disable caching.
REDIS_URL=redis://redis:6379/0
SEARCH_CACHE_TTL_SECONDS=300

# Whisper transcription (POST /api/v1/audio/transcribe)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
